<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Orchestral.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <!-- Clean Google Antigravity Input Styles (No harsh highlighting) -->
        <Style Selector="TextBox">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource GoogleBorderBrush}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource GoogleBorderBrush}" />
        </Style>

        <!-- Borderless input for Chat Capsule and Prompt areas -->
        <Style Selector="TextBox.plain">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TextBox.plain:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.plain:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- Google Antigravity Design System Palette -->
        <Color x:Key="GoogleDarkBackground">#131314</Color>
        <Color x:Key="GoogleSurface">#1E1F20</Color>
        <Color x:Key="GoogleSurfaceHigh">#282A2C</Color>
        <Color x:Key="GoogleBorder">#3C4043</Color>
        <Color x:Key="GoogleBorderSubtle">#282A2C</Color>

        <!-- Google Accents -->
        <Color x:Key="GoogleBlue">#8AB4F8</Color>
        <Color x:Key="GoogleBlueDark">#1A73E8</Color>
        <Color x:Key="GooglePurple">#C58AF9</Color>
        <Color x:Key="GoogleCyan">#78D9EC</Color>
        <Color x:Key="GoogleGreen">#81C995</Color>
        <Color x:Key="GoogleYellow">#FDD663</Color>
        <Color x:Key="GoogleRed">#F28B82</Color>
        <Color x:Key="GoogleTextPrimary">#E3E3E3</Color>
        <Color x:Key="GoogleTextSecondary">#9AA0A6</Color>
        <Color x:Key="GoogleTextMuted">#5F6368</Color>

        <!-- Solid Brushes -->
        <SolidColorBrush x:Key="GoogleDarkBackgroundBrush" Color="{StaticResource GoogleDarkBackground}" />
        <SolidColorBrush x:Key="GoogleSurfaceBrush" Color="{StaticResource GoogleSurface}" />
        <SolidColorBrush x:Key="GoogleSurfaceHighBrush" Color="{StaticResource GoogleSurfaceHigh}" />
        <SolidColorBrush x:Key="GoogleBorderBrush" Color="{StaticResource GoogleBorder}" />
        <SolidColorBrush x:Key="GoogleBorderSubtleBrush" Color="{StaticResource GoogleBorderSubtle}" />

        <SolidColorBrush x:Key="GoogleBlueBrush" Color="{StaticResource GoogleBlue}" />
        <SolidColorBrush x:Key="GoogleBlueDarkBrush" Color="{StaticResource GoogleBlueDark}" />
        <SolidColorBrush x:Key="GooglePurpleBrush" Color="{StaticResource GooglePurple}" />
        <SolidColorBrush x:Key="GoogleCyanBrush" Color="{StaticResource GoogleCyan}" />
        <SolidColorBrush x:Key="GoogleGreenBrush" Color="{StaticResource GoogleGreen}" />
        <SolidColorBrush x:Key="GoogleYellowBrush" Color="{StaticResource GoogleYellow}" />
        <SolidColorBrush x:Key="GoogleRedBrush" Color="{StaticResource GoogleRed}" />
        <SolidColorBrush x:Key="GoogleTextPrimaryBrush" Color="{StaticResource GoogleTextPrimary}" />
        <SolidColorBrush x:Key="GoogleTextSecondaryBrush" Color="{StaticResource GoogleTextSecondary}" />
        <SolidColorBrush x:Key="GoogleTextMutedBrush" Color="{StaticResource GoogleTextMuted}" />
        <SolidColorBrush x:Key="GoogleMutedBrush" Color="{StaticResource GoogleTextMuted}" />

        <!-- Antigravity Subtle Surface Gradients -->
        <LinearGradientBrush x:Key="AntigravityCanvasGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#111214" Offset="0.0" />
            <GradientStop Color="#15171B" Offset="0.5" />
            <GradientStop Color="#121315" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AntigravityHeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#1A1C1E" Offset="0.0" />
            <GradientStop Color="#1E2023" Offset="0.5" />
            <GradientStop Color="#1C1D20" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AntigravityAccentLineGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#8AB4F8" Offset="0.0" />
            <GradientStop Color="#C58AF9" Offset="0.5" />
            <GradientStop Color="#78D9EC" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AntigravitySidebarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#141517" Offset="0.0" />
            <GradientStop Color="#17191C" Offset="0.5" />
            <GradientStop Color="#141517" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NavButtonActiveGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#283446" Offset="0.0" />
            <GradientStop Color="#1E2736" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AntigravityCardGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1E1F22" Offset="0.0" />
            <GradientStop Color="#18191B" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Metric Cards -->
        <LinearGradientBrush x:Key="MetricCardBlueGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1A2433" Offset="0.0" />
            <GradientStop Color="#151B26" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MetricCardCyanGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#16272D" Offset="0.0" />
            <GradientStop Color="#121D22" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MetricCardYellowGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#2C2618" Offset="0.0" />
            <GradientStop Color="#1C180F" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MetricCardRedGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#2C191A" Offset="0.0" />
            <GradientStop Color="#1D1213" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Buttons -->
        <LinearGradientBrush x:Key="PrimaryActionGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1A73E8" Offset="0.0" />
            <GradientStop Color="#1557B0" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ApproveActionGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#137333" Offset="0.0" />
            <GradientStop Color="#0D5A27" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DenyActionGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#C5221F" Offset="0.0" />
            <GradientStop Color="#961614" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Badges -->
        <LinearGradientBrush x:Key="CitadelBadgeGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#133324" Offset="0.0" />
            <GradientStop Color="#0C2017" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TartarusBadgeGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#1D2338" Offset="0.0" />
            <GradientStop Color="#141827" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="IronGateBadgeGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#332712" Offset="0.0" />
            <GradientStop Color="#221A0C" Offset="1.0" />
        </LinearGradientBrush>

        <!-- StreamGeometry SVG Icons -->
