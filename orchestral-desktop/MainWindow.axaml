<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Orchestral.Desktop"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="840"
        x:Class="Orchestral.Desktop.MainWindow"
        Title="Orchestral - Autonomous Security Intelligence Platform"
        Width="1280" Height="840" MinWidth="1100" MinHeight="740"
        Background="{StaticResource AntigravityCanvasGradient}">

    <Grid RowDefinitions="Auto, *">
        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="{StaticResource AntigravityHeaderGradient}" 
                BorderBrush="{StaticResource GoogleBorderSubtleBrush}" BorderThickness="0,0,0,1" 
                Padding="20,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Google Antigravity Brand Emblem & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Canvas Width="34" Height="34">
                        <Polygon Points="17,2 2,17 17,17" Fill="{StaticResource GoogleBlueBrush}" Opacity="0.9" />
                        <Polygon Points="17,2 32,17 17,17" Fill="{StaticResource GooglePurpleBrush}" Opacity="0.9" />
                        <Polygon Points="2,17 17,32 17,17" Fill="{StaticResource GoogleCyanBrush}" Opacity="0.8" />
                        <Polygon Points="32,17 17,32 17,17" Fill="{StaticResource GoogleGreenBrush}" Opacity="0.8" />
                        <Path Canvas.Left="12" Canvas.Top="12" Width="10" Height="10" 
                              Data="{StaticResource IconSparkle}" Fill="White" Stretch="Uniform" />
                    </Canvas>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Orchestral" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="{StaticResource GoogleTextPrimaryBrush}" LetterSpacing="0.4" />
                            <Border Background="#1C2738" CornerRadius="4" Padding="6,2" BorderBrush="#263A54" BorderThickness="1">
                                <TextBlock Text="CITADEL" FontSize="10" FontWeight="Medium" 
                                           Foreground="{StaticResource GoogleBlueBrush}" FontFamily="Monospace" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Autonomous Security Swarm Intelligence" 
                                   FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Live Subsystem Telemetry Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Citadel Daemon Badge -->
                    <Border Background="{StaticResource CitadelBadgeGradient}" CornerRadius="14" Padding="10,5" 
                            BorderBrush="#1D4C33" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource GoogleGreenBrush}" />
                            <TextBlock x:Name="CitadelStatusText" Text="Citadel :8088 Connected" 
                                       FontSize="11" FontWeight="Medium" 
                                       Foreground="{StaticResource GoogleGreenBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Active Model Header Badge -->
                    <Border Background="{StaticResource TartarusBadgeGradient}" CornerRadius="14" Padding="10,5" 
                            BorderBrush="#2A334F" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSparkle}" Fill="{StaticResource GoogleBlueBrush}" Width="12" Height="12" Stretch="Uniform" />
                            <TextBlock x:Name="ActiveModelHeaderBadge" Text="Model: Gemini 2.5 Flash" FontSize="11" FontWeight="Medium" 
                                       Foreground="{StaticResource GoogleBlueBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Connected MCP Count Badge -->
                    <Border Background="{StaticResource MetricCardCyanGradient}" CornerRadius="14" Padding="10,5" 
                            BorderBrush="#1D3842" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTool}" Fill="{StaticResource GoogleCyanBrush}" Width="12" Height="12" Stretch="Uniform" />
                            <TextBlock x:Name="McpCountHeaderBadge" Text="MCP: 4 Connected" FontSize="11" FontWeight="Medium" 
                                       Foreground="{StaticResource GoogleCyanBrush}" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="RefreshButton" Click="OnRefreshClicked"
                            Background="{StaticResource GoogleSurfaceBrush}" BorderBrush="{StaticResource GoogleBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource GoogleTextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                            <TextBlock Text="Sync" FontSize="11" FontWeight="Medium" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE: SIDEBAR + CONTENT VIEW -->
        <Grid Grid.Row="1" ColumnDefinitions="240, *">
            <!-- LEFT NAVIGATION RAIL (4 ESSENTIAL TABS ONLY) -->
            <Border Grid.Column="0" Background="{StaticResource AntigravitySidebarGradient}" 
                    BorderBrush="{StaticResource GoogleBorderSubtleBrush}" BorderThickness="0,0,1,0" 
                    Padding="12,16">
                <Grid RowDefinitions="*, Auto">
                    <StackPanel Grid.Row="0" Spacing="6">
                        <TextBlock Text="WORKSPACES &amp; TOOLS" FontSize="10" FontWeight="SemiBold" 
                                   Foreground="{StaticResource GoogleTextMutedBrush}" Margin="10,0,0,10" LetterSpacing="0.5" />

                        <!-- TAB 1: AGENT CHAT -->
                        <Button x:Name="NavChat" Click="OnNavClicked" Tag="Chat"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{StaticResource NavButtonActiveGradient}" BorderBrush="{StaticResource GoogleBlueBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconChat}" Fill="{StaticResource GoogleBlueBrush}" Width="15" Height="15" Stretch="Uniform" />
                                <TextBlock Text="Agent Chat" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- TAB 2: AI MODEL PROVIDERS -->
                        <Button x:Name="NavProviders" Click="OnNavClicked" Tag="Providers"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSparkle}" Fill="{StaticResource GooglePurpleBrush}" Width="15" Height="15" Stretch="Uniform" />
                                <TextBlock Text="AI Model Providers" Foreground="{StaticResource GoogleTextSecondaryBrush}" FontWeight="Normal" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- TAB 3: MCPS & INTEGRATIONS -->
                        <Button x:Name="NavMcp" Click="OnNavClicked" Tag="Mcp"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTool}" Fill="{StaticResource GoogleCyanBrush}" Width="15" Height="15" Stretch="Uniform" />
                                <TextBlock Text="MCPs &amp; Integrations" Foreground="{StaticResource GoogleTextSecondaryBrush}" FontWeight="Normal" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- TAB 4: SETTINGS -->
                        <Button x:Name="NavSettings" Click="OnNavClicked" Tag="Settings"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" Fill="{StaticResource GoogleBlueBrush}" Width="15" Height="15" Stretch="Uniform" />
                                <TextBlock Text="Settings" Foreground="{StaticResource GoogleTextSecondaryBrush}" FontWeight="Normal" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Workspace Environment Card -->
                    <Border Grid.Row="1" Background="{StaticResource AntigravityCardGradient}" CornerRadius="8" 
                            BorderBrush="{StaticResource GoogleBorderSubtleBrush}" BorderThickness="1" Padding="12,10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="WORKSPACE CONTEXT" FontSize="10" FontWeight="SemiBold" 
                                       Foreground="{StaticResource GoogleTextMutedBrush}" LetterSpacing="0.4" />
                            <TextBlock x:Name="WorkspaceLocationText" Text="Location: /home/admin/Swarm" FontSize="11" FontWeight="Medium" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontFamily="Monospace" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MemoryTelemetryText" Text="Runtime Memory: 48 MB" 
                                       FontSize="11" Foreground="{StaticResource GoogleGreenBrush}" />
                            <TextBlock Text="Daemon: 127.0.0.1:8088" FontSize="10" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE VIEWPORT -->
            <Border Grid.Column="1" Padding="24">
                <Grid>
                    <!-- VIEW 1: AGENT CHAT SESSION (3-COLUMN WORKSPACE SESSIONS & ORCHESTRATION) -->
                    <Grid x:Name="ViewChat" IsVisible="True" ColumnDefinitions="260, 1, *">
                        <!-- Left Workspace Sessions Rail -->
                        <Border Grid.Column="0" Background="{StaticResource AntigravitySidebarGradient}" 
                                BorderBrush="{StaticResource GoogleBorderSubtleBrush}" BorderThickness="0,0,1,0" 
                                Padding="12,10" Margin="-24,-24,0,-24">
                            <Grid RowDefinitions="Auto, Auto, *">
                                <!-- Top Action: New Session -->
                                <Button Grid.Row="0" x:Name="NewSessionButton" Click="OnNewSessionClicked"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{StaticResource GoogleSurfaceHighBrush}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPlus}" Fill="{StaticResource GoogleBlueBrush}" Width="12" Height="12" Stretch="Uniform" />
                                        <TextBlock Text="New Chat Session" FontWeight="Medium" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Grid.Row="1" Text="SESSIONS BY WORKSPACE" FontSize="10" FontWeight="SemiBold" 
                                           Foreground="{StaticResource GoogleTextMutedBrush}" LetterSpacing="0.4" Margin="2,0,0,8" />

                                <!-- Sessions List grouped by folder location -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SessionGroupsContainer" Spacing="6" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Center Divider -->
                        <Border Grid.Column="1" Background="{StaticResource GoogleBorderSubtleBrush}" Margin="0,-24,0,-24" />

                        <!-- Right Main Chat Area -->
                        <Grid Grid.Column="2" RowDefinitions="Auto, *, Auto" Margin="20,0,0,0">
                            <!-- Chat Header -->
                            <Border Grid.Row="0" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconChat}" Fill="{StaticResource GoogleBlueBrush}" Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock x:Name="ActiveSessionTitleText" Text="Orchestral Intelligence Swarm" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            <!-- Scope badge -->
                                            <Border x:Name="ScopeBadgeBorder" Background="#133324" CornerRadius="4" Padding="6,2" BorderBrush="#1D4C33" BorderThickness="1" Margin="6,0,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconLock}" Fill="{StaticResource GoogleGreenBrush}" Width="10" Height="10" Stretch="Uniform" />
                                                    <TextBlock x:Name="ScopeBadgeText" Text="Scope: CWD Only" FontSize="10" FontWeight="Medium" Foreground="{StaticResource GoogleGreenBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Chrome MCP Badge -->
                                            <Border x:Name="ChromeMcpBadgeBorder" Background="#12242D" CornerRadius="4" Padding="6,2" BorderBrush="#1C4050" BorderThickness="1" IsVisible="True">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconChrome}" Fill="{StaticResource GoogleCyanBrush}" Width="10" Height="10" Stretch="Uniform" />
                                                    <TextBlock Text="Chrome MCP: Active" FontSize="10" FontWeight="Medium" Foreground="{StaticResource GoogleCyanBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="ActiveSessionPathText" Text="Workspace: /home/admin/Swarm" FontSize="11" FontFamily="Monospace" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Right Action Deck -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Subagent Activity Inspector Button -->
                                        <Button x:Name="InspectSubagentsButton" Click="OnInspectSubagentsClicked"
                                                Background="{StaticResource GoogleSurfaceBrush}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconSubagent}" Fill="{StaticResource GooglePurpleBrush}" Width="13" Height="13" Stretch="Uniform" />
                                                <TextBlock x:Name="SubagentStatusSummaryText" Text="Inspect Subagents" FontSize="11" FontWeight="Medium" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Background Tasks Pill -->
                                        <Border x:Name="BgTasksPill" Background="#1C2738" CornerRadius="6" Padding="8,4" BorderBrush="#263A54" BorderThickness="1" IsVisible="False">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource GoogleCyanBrush}" />
                                                <TextBlock x:Name="BgTasksCountText" Text="0 Background Tasks" FontSize="11" FontFamily="Monospace" Foreground="{StaticResource GoogleCyanBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Model Selector Dropdown -->
                                        <Border Background="{StaticResource GoogleSurfaceBrush}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                                            <ComboBox x:Name="ModelSelector" SelectedIndex="0" SelectionChanged="OnModelSelectionChanged"
                                                      Background="Transparent" BorderThickness="0" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12">
                                                <ComboBoxItem Content="Gemini 2.5 Flash (Recommended)" Tag="gemini-2.5-flash" />
                                                <ComboBoxItem Content="Gemini 2.5 Pro (Deep Analysis)" Tag="gemini-2.5-pro" />
                                                <ComboBoxItem Content="Claude 3.7 Sonnet (Advanced)" Tag="claude-3.7-sonnet" />
                                                <ComboBoxItem Content="GPT-4o (Reasoning)" Tag="gpt-4o" />
                                                <ComboBoxItem Content="DeepSeek-R1 (Open Reasoning)" Tag="deepseek-r1" />
                                                <ComboBoxItem Content="Ollama Llama 3.3 (Local Air-Gapped)" Tag="ollama-llama" />
                                                <ComboBoxItem Content="Local Citadel Engine" Tag="citadel-local" />
                                                <ComboBoxItem Content="+ Configure Providers..." Tag="configure-providers" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Chat Message Stream -->
                            <ScrollViewer Grid.Row="1" x:Name="ChatScroller" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ChatHistory" MaxWidth="880" HorizontalAlignment="Stretch" Spacing="16" Margin="0,0,0,16" />
                            </ScrollViewer>

                            <!-- Antigravity Prompt Capsule Input Bar -->
                            <Border Grid.Row="2" MaxWidth="880" HorizontalAlignment="Stretch" Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,8,0,0">
                                <Grid RowDefinitions="Auto, Auto, Auto">
                                    <!-- Context Attachment Chips Panel -->
                                    <WrapPanel Grid.Row="0" x:Name="AttachmentChipsPanel" Margin="0,0,0,8" IsVisible="False" />

                                    <!-- Main Input Field -->
                                    <TextBox x:Name="ChatInput" Grid.Row="1"
                                             Classes="plain"
                                             Watermark="Message Orchestral agent or describe an objective..."
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource GoogleTextPrimaryBrush}"
                                             FontSize="13" Padding="0,0,0,8"
                                             AcceptsReturn="True" MinHeight="38" MaxHeight="120"
                                             TextWrapping="Wrap" />

                                    <!-- Bottom Action Bar -->
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,4,0,0">
                                        <!-- Add Context / Attachment Tool Button -->
                                        <Button Grid.Column="0" x:Name="AttachContextButton"
                                                Background="{StaticResource GoogleSurfaceHighBrush}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="10,5">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="TopEdgeAlignedLeft">
                                                    <MenuItem Header="Add Target File..." Click="OnAttachFileClicked">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconFile}" Fill="{StaticResource GoogleBlueBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Add Project Folder..." Click="OnAttachFolderClicked">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource GoogleYellowBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Add Security Tool">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconTool}" Fill="{StaticResource GoogleCyanBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                        </MenuItem.Icon>
                                                        <MenuItem Header="Nmap Network Scanner" Click="OnAttachToolItemClicked" Tag="tool:nmap" />
                                                        <MenuItem Header="Sqlmap Injection Assessor" Click="OnAttachToolItemClicked" Tag="tool:sqlmap" />
                                                        <MenuItem Header="Nikto Web Scanner" Click="OnAttachToolItemClicked" Tag="tool:nikto" />
                                                        <MenuItem Header="Semgrep SAST Code Auditor" Click="OnAttachToolItemClicked" Tag="tool:semgrep" />
                                                        <MenuItem Header="John the Ripper Hash Cracker" Click="OnAttachToolItemClicked" Tag="tool:john" />
                                                        <MenuItem Header="Tartarus Hardened Container" Click="OnAttachToolItemClicked" Tag="tool:tartarus" />
                                                    </MenuItem>
                                                    <MenuItem Header="Chrome MCP Browser">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconChrome}" Fill="{StaticResource GoogleCyanBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                        </MenuItem.Icon>
                                                        <MenuItem Header="Browse Remote Web Target" Click="OnAttachChromeMcpActionClicked" Tag="chrome:browse" />
                                                        <MenuItem Header="Inspect Web DOM &amp; Form Fields" Click="OnAttachChromeMcpActionClicked" Tag="chrome:inspect" />
                                                        <MenuItem Header="Extract Page Content &amp; Headers" Click="OnAttachChromeMcpActionClicked" Tag="chrome:extract" />
                                                    </MenuItem>
                                                    <MenuItem Header="Mention Operative">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconSwarm}" Fill="{StaticResource GooglePurpleBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                        </MenuItem.Icon>
                                                        <MenuItem Header="@archon (Swarm Lead Coordinator)" Click="OnAttachMentionClicked" Tag="@archon" />
                                                        <MenuItem Header="@sentinel (Reconnaissance Specialist)" Click="OnAttachMentionClicked" Tag="@sentinel" />
                                                        <MenuItem Header="@cerberus (DAST Vulnerability Assessor)" Click="OnAttachMentionClicked" Tag="@cerberus" />
                                                        <MenuItem Header="@athena (SAST Code Auditor)" Click="OnAttachMentionClicked" Tag="@athena" />
                                                        <MenuItem Header="@justiciar (Triage Specialist)" Click="OnAttachMentionClicked" Tag="@justiciar" />
                                                    </MenuItem>
                                                    <MenuItem Header="Security Directives">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconRadar}" Fill="{StaticResource GoogleGreenBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                        </MenuItem.Icon>
                                                        <MenuItem Header="Directive: Run Full Perimeter Recon" Click="OnQuickActionItemClicked" Tag="Perform complete network service and port discovery" />
                                                        <MenuItem Header="Directive: Web Vulnerability Audit" Click="OnQuickActionItemClicked" Tag="Assess endpoints for OWASP Top 10 vulnerabilities" />
                                                        <MenuItem Header="Directive: Code Secrets and Taint Scan" Click="OnQuickActionItemClicked" Tag="Scan workspace repositories for hardcoded credentials and taint flows" />
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource GoogleTextPrimaryBrush}" Width="11" Height="11" Stretch="Uniform" />
                                                <TextBlock Text="Add Context" FontSize="11" FontWeight="Medium" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Guide hint -->
                                        <TextBlock Grid.Column="1" Text="Press Enter to send, Shift+Enter for new line" FontSize="11" Foreground="{StaticResource GoogleTextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />

                                        <!-- Run in Background Option -->
                                        <CheckBox Grid.Column="2" x:Name="RunInBackgroundCheck" Content="Run in Background" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <!-- Send Button -->
                                        <Button Grid.Column="3" x:Name="SendChatButton" Click="OnSendChatClicked"
                                                Background="{StaticResource PrimaryActionGradient}" BorderBrush="{StaticResource GoogleBlueBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="16,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconSend}" Fill="White" Width="12" Height="12" Stretch="Uniform" />
                                                <TextBlock Text="Send" FontWeight="Medium" Foreground="White" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- VIEW 2: AI MODEL PROVIDERS (DEDICATED FULL TAB) -->
                    <ScrollViewer x:Name="ViewProviders" IsVisible="False">
                        <StackPanel Spacing="18" MaxWidth="920" HorizontalAlignment="Left">
                            <!-- Header & Global Actions -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSparkle}" Fill="{StaticResource GooglePurpleBrush}" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="AI Model Providers &amp; Endpoint Connections" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Configure API keys, custom base URLs, and model routing. All API keys are masked by default." FontSize="12" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="OnSaveAllProvidersClicked"
                                        Background="{StaticResource PrimaryActionGradient}" BorderBrush="{StaticResource GoogleBlueBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="16,8">
                                    <TextBlock Text="Save All Provider Credentials" FontWeight="Medium" Foreground="White" FontSize="12" />
                                </Button>
                            </Grid>

                            <TextBlock x:Name="ProvidersStatusNotice" Text="" FontSize="11" Foreground="{StaticResource GoogleGreenBrush}" IsVisible="False" />

                            <!-- 1. Google Gemini & Vertex AI -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSparkle}" Fill="{StaticResource GoogleBlueBrush}" Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Google Gemini &amp; Vertex AI" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            <Border Background="#133324" CornerRadius="4" Padding="6,2" BorderBrush="#1D4C33" BorderThickness="1">
                                                <TextBlock Text="Recommended" FontSize="10" FontWeight="Medium" Foreground="{StaticResource GoogleGreenBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnTestProviderConnectionClicked" Tag="gemini"
                                                    Background="{StaticResource GoogleSurfaceHighBrush}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock Text="Test Connection" FontSize="11" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            </Button>
                                            <CheckBox x:Name="GeminiProviderCheck" IsChecked="True" Content="Enabled" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="160, *" RowDefinitions="Auto, Auto, Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key (Masked)" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                            <TextBox Grid.Column="0" x:Name="SettingsGeminiKeyBox" PasswordChar="*" Watermark="Paste Google Gemini API Key (e.g. AIzaSy...)" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                            <Button Grid.Column="1" Click="OnTogglePasswordVisibilityClicked" Tag="SettingsGeminiKeyBox" Background="Transparent" BorderThickness="0" Padding="6,4">
