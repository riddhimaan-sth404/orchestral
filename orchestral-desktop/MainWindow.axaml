                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key (Masked)" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                            <TextBox Grid.Column="0" x:Name="SettingsTogetherKeyBox" PasswordChar="*" Watermark="Paste Together API Key..." Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                            <Button Grid.Column="1" Click="OnTogglePasswordVisibilityClicked" Tag="SettingsTogetherKeyBox" Background="Transparent" BorderThickness="0" Padding="6,4">
                                                <Path Data="{StaticResource IconEye}" Fill="{StaticResource GoogleTextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                            </Button>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL Override" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TogetherBaseUrlBox" Text="https://api.together.xyz/v1" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Default Model" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TogetherModelCombo" SelectedIndex="0" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="meta-llama/Llama-3.3-70B-Instruct-Turbo" />
                                            <ComboBoxItem Content="deepseek-ai/DeepSeek-R1" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 10. Custom OpenAI-Compatible Provider (vLLM / LM Studio / LiteLLM) -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSettings}" Fill="{StaticResource GoogleCyanBrush}" Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Custom OpenAI-Compatible Endpoint" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnTestProviderConnectionClicked" Tag="custom"
                                                    Background="{StaticResource GoogleSurfaceHighBrush}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock Text="Test Connection" FontSize="11" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            </Button>
                                            <CheckBox x:Name="CustomProviderCheck" IsChecked="False" Content="Enabled" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="160, *" RowDefinitions="Auto, Auto, Auto, Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider Name" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CustomProviderNameBox" Watermark="e.g. Local vLLM Gateway" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Endpoint Base URL" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CustomBaseUrlBox" Watermark="e.g. http://127.0.0.1:8000/v1" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key (Masked)" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                            <TextBox Grid.Column="0" x:Name="SettingsCustomKeyBox" PasswordChar="*" Watermark="Optional Bearer token..." Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                            <Button Grid.Column="1" Click="OnTogglePasswordVisibilityClicked" Tag="SettingsCustomKeyBox" Background="Transparent" BorderThickness="0" Padding="6,4">
                                                <Path Data="{StaticResource IconEye}" Fill="{StaticResource GoogleTextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                            </Button>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Custom Model ID" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CustomModelIdBox" Watermark="e.g. meta-llama/Llama-3.3-70B-Instruct" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- VIEW 3: MCPS & INTEGRATIONS (DEDICATED FULL TAB) -->
                    <ScrollViewer x:Name="ViewMcp" IsVisible="False">
                        <StackPanel Spacing="18" MaxWidth="920" HorizontalAlignment="Left">
                            <!-- Header -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconTool}" Fill="{StaticResource GoogleCyanBrush}" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="Model Context Protocol (MCP) &amp; Tool Integrations" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Sidecar tools, remote browser automation, execution sandboxes, and collaborative blackboard services." FontSize="12" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="McpStatusNotice" Text="" FontSize="11" Foreground="{StaticResource GoogleGreenBrush}" IsVisible="False" />

                            <!-- 1. Chrome MCP Server -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconChrome}" Fill="{StaticResource GoogleCyanBrush}" Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Chrome MCP Server (Browsing &amp; Puppeteer)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            <Border Background="#12242D" CornerRadius="4" Padding="6,2" BorderBrush="#1C4050" BorderThickness="1">
                                                <TextBlock Text="Remote DevTools" FontSize="10" FontWeight="Medium" Foreground="{StaticResource GoogleCyanBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnTestChromeMcpClicked"
                                                    Background="{StaticResource GoogleSurfaceHighBrush}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock Text="Test Connection" FontSize="11" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            </Button>
                                            <CheckBox x:Name="ChromeMcpCheck" IsChecked="True" Checked="OnChromeMcpToggleChanged" Unchecked="OnChromeMcpToggleChanged" Content="Enabled" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Enables autonomous web crawling, DOM tree inspection, form element interaction, cookie extraction, and dynamic JavaScript rendering." FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="160, *" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="DevTools Endpoint URL" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" x:Name="ChromeMcpEndpointBox" Text="http://127.0.0.1:9222" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. Tartarus Hardened Container MCP -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTerminal}" Fill="{StaticResource GoogleYellowBrush}" Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Tartarus Container Sandbox MCP" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            <Border Background="#332712" CornerRadius="4" Padding="6,2" BorderBrush="#48371B" BorderThickness="1">
                                                <TextBlock Text="Podman Rootless" FontSize="10" FontWeight="Medium" Foreground="{StaticResource GoogleYellowBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <CheckBox x:Name="TartarusMcpCheck" Grid.Column="2" IsChecked="True" Content="Enabled" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Provides safe isolated runtime for Nmap, Nikto, Sqlmap, Semgrep, and hash cracking tools with PID limits and zero host privileges." FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="160, *" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Container Command" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="podman run --rm -i --network=host tartarus-kali" IsReadOnly="True" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextSecondaryBrush}" FontSize="11" FontFamily="Monospace" Padding="10,8" CornerRadius="6" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Filesystem MCP Server -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource GoogleBlueBrush}" Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Filesystem MCP Server" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            <Border Background="#133324" CornerRadius="4" Padding="6,2" BorderBrush="#1D4C33" BorderThickness="1">
                                                <TextBlock Text="CWD Sandboxed" FontSize="10" FontWeight="Medium" Foreground="{StaticResource GoogleGreenBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <CheckBox x:Name="FsMcpCheck" Grid.Column="2" IsChecked="True" Content="Enabled" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Constrained file search, AST grep, text patch verification, and workspace file editing under IronGate policy rules." FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="160, *" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Allowed Root Path" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" x:Name="FsMcpRootBox" Watermark="e.g. /home/admin/Swarm" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. Citadel Operations & Blackboard MCP -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSwarm}" Fill="{StaticResource GooglePurpleBrush}" Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Citadel Operations &amp; Blackboard MCP" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            <Border Background="#1C2738" CornerRadius="4" Padding="6,2" BorderBrush="#263A54" BorderThickness="1">
                                                <TextBlock Text="Port :8088" FontSize="10" FontWeight="Medium" Foreground="{StaticResource GoogleBlueBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <CheckBox x:Name="CitadelMcpCheck" Grid.Column="2" IsChecked="True" Content="Enabled" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Multi-agent shared blackboard intelligence state, synchronized vulnerability logging, and Zero-Trust IronGate queue." FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="160, *" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Service Base URL" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="http://127.0.0.1:8088" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 5. PostgreSQL MCP -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconIntel}" Fill="{StaticResource GoogleBlueBrush}" Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="PostgreSQL Database MCP" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                        </StackPanel>
                                        <CheckBox x:Name="PostgresMcpCheck" Grid.Column="2" IsChecked="False" Content="Enabled" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="160, *" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Connection URI (Masked)" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0" x:Name="PostgresMcpUriBox" PasswordChar="*" Watermark="postgresql://user:pass@localhost:5432/dbname" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                            <Button Grid.Column="1" Click="OnTogglePasswordVisibilityClicked" Tag="PostgresMcpUriBox" Background="Transparent" BorderThickness="0" Padding="6,4">
                                                <Path Data="{StaticResource IconEye}" Fill="{StaticResource GoogleTextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 6. Register Custom MCP Server -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPlus}" Fill="{StaticResource GoogleBlueBrush}" Width="14" Height="14" Stretch="Uniform" />
                                        <TextBlock Text="Register Custom MCP Server" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource GoogleBlueBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Add any community or organization-specific MCP server (e.g. GitHub, Slack, Jira, Snyk, Docker) via Stdio command or Remote SSE." FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" />

                                    <Grid ColumnDefinitions="160, *" RowDefinitions="Auto, Auto, Auto, Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Server Identifier" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CustomMcpNameBox" Watermark="e.g. github-mcp" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Transport Type" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CustomMcpTypeCombo" SelectedIndex="0" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                            <ComboBoxItem Content="Local Stdio (Command + Arguments)" />
                                            <ComboBoxItem Content="Remote SSE (Server-Sent Events URL)" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Command / URL" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CustomMcpCmdBox" Watermark="npx -y @modelcontextprotocol/server-... OR https://..." Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Token / Env (Masked)" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0" x:Name="CustomMcpTokenBox" PasswordChar="*" Watermark="Optional Bearer token or secret..." Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                            <Button Grid.Column="1" Click="OnTogglePasswordVisibilityClicked" Tag="CustomMcpTokenBox" Background="Transparent" BorderThickness="0" Padding="6,4">
                                                <Path Data="{StaticResource IconEye}" Fill="{StaticResource GoogleTextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <Button HorizontalAlignment="Right" Click="OnAddCustomMcpClicked"
                                            Background="{StaticResource PrimaryActionGradient}" BorderBrush="{StaticResource GoogleBlueBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="16,6">
                                        <TextBlock Text="Add MCP Server" FontWeight="Medium" Foreground="White" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- VIEW 4: SETTINGS (OPENCODE-LEVEL COMPREHENSIVE CONFIGURATION) -->
                    <ScrollViewer x:Name="ViewSettings" IsVisible="False">
                        <StackPanel Spacing="18" MaxWidth="920" HorizontalAlignment="Left">
                            <!-- Header & Save/Export -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSettings}" Fill="{StaticResource GoogleBlueBrush}" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="Platform Settings &amp; OpenCode Configuration" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Granular agent runtime control, OpenCode tool permissions table, reasoning effort, and directory isolation boundaries." FontSize="12" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="OnSaveSettingsKeysClicked"
                                        Background="{StaticResource PrimaryActionGradient}" BorderBrush="{StaticResource GoogleBlueBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="16,8">
                                    <TextBlock Text="Save &amp; Export opencode.json" FontWeight="Medium" Foreground="White" FontSize="12" />
                                </Button>
                            </Grid>

                            <TextBlock x:Name="SettingsKeySaveNotice" Text="" FontSize="11" Foreground="{StaticResource GoogleGreenBrush}" IsVisible="False" />

                            <!-- Card 1: Agent Defaults & Reasoning Parameters -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="AGENT DEFAULTS &amp; REASONING (OPENCODE MODEL CONFIG)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GoogleBlueBrush}" LetterSpacing="0.4" />
                                    <Grid ColumnDefinitions="190, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default Active Model" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SettingsDefaultModelCombo" SelectedIndex="0" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                            <ComboBoxItem Content="gemini-2.5-flash (Fast &amp; Accurate)" />
                                            <ComboBoxItem Content="gemini-2.5-pro (Deep Analysis)" />
                                            <ComboBoxItem Content="claude-3-7-sonnet-20250219 (Advanced Reasoning)" />
                                            <ComboBoxItem Content="gpt-4o (Multimodal Reasoning)" />
                                            <ComboBoxItem Content="deepseek-r1 (High Reasoning Effort)" />
                                            <ComboBoxItem Content="ollama/llama3.3:latest (Local Air-Gapped)" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Autonomy &amp; Action Tier" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SettingsAutonomyCombo" SelectedIndex="0" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                            <ComboBoxItem Content="Active Autonomy (Auto-execute approved actions, ask on high risk)" />
                                            <ComboBoxItem Content="Supervised Walkthrough (Ask confirmation for file writes and scans)" />
                                            <ComboBoxItem Content="Strict Zero-Trust (Require explicit confirmation for every single tool call)" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Reasoning &amp; Thinking Effort" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SettingsThinkingCombo" SelectedIndex="1" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                            <ComboBoxItem Content="Low (Direct fast execution with minimal internal chain-of-thought)" />
                                            <ComboBoxItem Content="Medium (Standard analytical verification before actions)" />
                                            <ComboBoxItem Content="High (Deep exhaustive security auditing and multi-step plan verification)" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Sampling Temperature" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="SettingsTempBox" Text="0.2" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" Margin="0,0,0,10" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Context Window" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="SettingsContextCombo" SelectedIndex="1" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="128k Tokens (Standard)" />
                                            <ComboBoxItem Content="200k Tokens (Extended Working Memory)" />
                                            <ComboBoxItem Content="1M Tokens (Full Codebase Ingestion)" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: OpenCode Tool Permissions Matrix -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="TOOL PERMISSIONS MATRIX (OPENCODE PERMISSION RULES)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GoogleYellowBrush}" LetterSpacing="0.4" />
                                        <TextBlock Text="Control tool behavior exactly as in opencode.json permissions: allow without prompting, ask for confirmation, or deny execution entirely." FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Table Header -->
                                    <Border Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <Grid ColumnDefinitions="140, *, 180">
                                            <TextBlock Grid.Column="0" Text="TOOL NAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource GoogleTextMutedBrush}" LetterSpacing="0.4" />
                                            <TextBlock Grid.Column="1" Text="DESCRIPTION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource GoogleTextMutedBrush}" LetterSpacing="0.4" />
                                            <TextBlock Grid.Column="2" Text="POLICY RULE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource GoogleTextMutedBrush}" LetterSpacing="0.4" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- Row: bash -->
                                    <Grid ColumnDefinitions="140, *, 180">
                                        <TextBlock Grid.Column="0" Text="bash / exec" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource GoogleCyanBrush}" FontFamily="Monospace" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Execution of terminal shell commands and tools" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" x:Name="PermBashCombo" SelectedIndex="1" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" Width="140">
                                            <ComboBoxItem Content="allow" />
                                            <ComboBoxItem Content="ask (confirm)" />
                                            <ComboBoxItem Content="deny" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Row: edit/write -->
                                    <Grid ColumnDefinitions="140, *, 180">
                                        <TextBlock Grid.Column="0" Text="edit / write" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource GoogleYellowBrush}" FontFamily="Monospace" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Creating and modifying project files on disk" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" x:Name="PermEditCombo" SelectedIndex="0" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" Width="140">
                                            <ComboBoxItem Content="allow" />
                                            <ComboBoxItem Content="ask (confirm)" />
                                            <ComboBoxItem Content="deny" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Row: read -->
                                    <Grid ColumnDefinitions="140, *, 180">
                                        <TextBlock Grid.Column="0" Text="read / search" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource GoogleGreenBrush}" FontFamily="Monospace" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Inspecting files, code grep, and directory contents" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" x:Name="PermReadCombo" SelectedIndex="0" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" Width="140">
                                            <ComboBoxItem Content="allow" />
                                            <ComboBoxItem Content="ask (confirm)" />
                                            <ComboBoxItem Content="deny" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Row: webfetch / chrome -->
                                    <Grid ColumnDefinitions="140, *, 180">
                                        <TextBlock Grid.Column="0" Text="webfetch / browse" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource GoogleBlueBrush}" FontFamily="Monospace" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Live Chrome DevTools crawling and remote HTTP requests" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" x:Name="PermWebCombo" SelectedIndex="0" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" Width="140">
                                            <ComboBoxItem Content="allow" />
                                            <ComboBoxItem Content="ask (confirm)" />
                                            <ComboBoxItem Content="deny" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Row: network_scan -->
                                    <Grid ColumnDefinitions="140, *, 180">
                                        <TextBlock Grid.Column="0" Text="network_scan" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource GoogleRedBrush}" FontFamily="Monospace" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Port scanning and dynamic vulnerability probing" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" x:Name="PermScanCombo" SelectedIndex="1" Background="#141517" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" Width="140">
                                            <ComboBoxItem Content="allow" />
                                            <ComboBoxItem Content="ask (confirm)" />
                                            <ComboBoxItem Content="deny" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Execution Scope & Directory Confinement -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="AGENT EXECUTION SCOPE &amp; BOUNDARIES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GoogleGreenBrush}" LetterSpacing="0.4" />
                                    <RadioButton x:Name="ScopeCwdOnlyRadio" GroupName="AgentScopeGroup" IsChecked="True" Checked="OnScopeModeChanged">
                                        <StackPanel Spacing="2" Margin="6,0,0,0">
                                            <TextBlock Text="Current Working Directory (CWD Only) [Recommended]" FontWeight="Medium" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            <TextBlock Text="Sandboxes agent actions strictly to the workspace directory. Tasks targeting external paths request in-chat user confirmation." FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ScopeGlobalRadio" GroupName="AgentScopeGroup" Checked="OnScopeModeChanged">
                                        <StackPanel Spacing="2" Margin="6,0,0,0">
                                            <TextBlock Text="Global Sessions [Unrestricted Scope]" FontWeight="Medium" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                                            <TextBlock Text="Agent has global filesystem and environment execution authority without asking for directory approvals." FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: OpenCode Custom Instructions -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CUSTOM AGENT INSTRUCTIONS (OPENCODE INSTRUCTIONS DIRECTIVE)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GooglePurpleBrush}" LetterSpacing="0.4" />
                                    <TextBlock Text="Additional guidelines, rules, and behavioral boundaries injected into the primary agent's prompt context." FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                    <TextBox x:Name="CustomInstructionsBox" Watermark="e.g. Always follow OWASP Top 10 standards. Validate all findings before logging. Confine reconnaissance to authorized host targets." AcceptsReturn="True" Height="70" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10" CornerRadius="6" />
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Citadel Authentication & Local Persistence -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="CITADEL DAEMON &amp; ENGINE PERSISTENCE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GoogleBlueBrush}" LetterSpacing="0.4" />
                                    <Grid ColumnDefinitions="190, *" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Citadel Daemon Key (Masked)" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0" x:Name="SettingsCitadelKeyBox" PasswordChar="*" Watermark="Citadel Operations Bearer Token..." Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" />
                                            <Button Grid.Column="1" Click="OnTogglePasswordVisibilityClicked" Tag="SettingsCitadelKeyBox" Background="Transparent" BorderThickness="0" Padding="6,4">
                                                <Path Data="{StaticResource IconEye}" Fill="{StaticResource GoogleTextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <CheckBox x:Name="CitadelWalCheck" IsChecked="True" Content="Enable Append-Only SQLite WAL Persistence Ledger" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                    <CheckBox x:Name="GcOptimizationCheck" IsChecked="True" Content="Aggressive Workstation GC Memory Compaction" FontSize="11" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- SUBAGENT ACTIVITY INSPECTOR MODAL OVERLAY -->
        <Border Grid.Row="0" Grid.RowSpan="2" x:Name="SubagentsModalOverlay" IsVisible="False"
                Background="#B2000000" Padding="40">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" MaxHeight="600"
                    Background="{StaticResource GoogleSurfaceBrush}" BorderBrush="{StaticResource GoogleBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSubagent}" Fill="{StaticResource GoogleBlueBrush}" Width="16" Height="16" Stretch="Uniform" />
                                <TextBlock Text="Subagent Orchestration Activity Inspector" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Live telemetry and command traces for non-user-facing delegated worker agents" FontSize="12" Foreground="{StaticResource GoogleTextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCloseSubagentsModalClicked"
                                Background="Transparent" BorderThickness="0" Padding="8,4">
                            <Path Data="{StaticResource IconCross}" Fill="{StaticResource GoogleTextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Subagents List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SubagentsInspectorPanel" Spacing="10" />
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Note: Subagents are autonomous workers invoked by the primary agent and cannot be messaged directly." FontSize="11" Foreground="{StaticResource GoogleTextMutedBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Click="OnCloseSubagentsModalClicked"
                                    Background="{StaticResource GoogleSurfaceHighBrush}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="16,6">
                                <TextBlock Text="Close" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>