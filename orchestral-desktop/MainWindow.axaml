                            <!-- 6. Ollama / Local Air-Gapped LLM -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
