                                </StackPanel>
                            </Border>

                            <!-- 2. Anthropic Claude -->
                            <Border Background="{StaticResource AntigravityCardGradient}" BorderBrush="{StaticResource GoogleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconChat}" Fill="{StaticResource GooglePurpleBrush}" Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Anthropic Claude" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource GoogleTextPrimaryBrush}" />
