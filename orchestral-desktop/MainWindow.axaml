                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClaudeBaseUrlBox" Text="https://api.anthropic.com/v1" Background="#141517" BorderBrush="{StaticResource GoogleBorderSubtleBrush}" Foreground="{StaticResource GoogleTextPrimaryBrush}" FontSize="12" Padding="10,8" CornerRadius="6" Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Default Model" FontSize="12" Foreground="{StaticResource GoogleTextPrimaryBrush}" VerticalAlignment="Center" />
